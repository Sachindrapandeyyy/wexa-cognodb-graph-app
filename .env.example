# ==============================================================================
# AEGISGRAPH ? COGNODB CONFIGURATION
# ==============================================================================
# 1. Sign up at https://console.cognodb.com (Free tier, no credit card required)
# 2. Create a free database instance
# 3. Copy your instance connection details below:

COGNODB_URI=bolt+s://<your-instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=<your-generated-instance-password>
COGNODB_DATABASE=neo4j

# Application Environment
APP_ENV=development
PORT=8000
HOST=0.0.0.0
DEMO_MODE_FALLBACK=true
